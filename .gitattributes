# Normalisation universelle des fins de lignes (LF pour tout fichier texte)
* text=auto eol=lf

# Fichiers de configuration Windows
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Fichiers binaires
*.db binary
*.sqlite binary
*.bin binary
*.pt binary
*.onnx binary
*.png binary
*.jpg binary
*.ico binary
